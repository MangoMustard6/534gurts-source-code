modules = ["python-3.11", "nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "IHTX Discord Bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "IHTX Discord Bot (TypeScript)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Pipeline Visualizer"

[[workflows.workflow]]
name = "IHTX Discord Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -q -r requirements.txt && PYTHONUNBUFFERED=1 python3 -u main.py"

[[workflows.workflow]]
name = "IHTX Discord Bot (TypeScript)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install --frozen-lockfile && pnpm --filter @workspace/discord-bot run dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Pipeline Visualizer"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8099 node public/serve.mjs"
waitForPort = 8099

[agent]
stack = "FLASK_VANILLA_JS"
expertMode = true
integrations = []

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8099
externalPort = 80

[userenv]

[userenv.shared]
PORT = "8099"

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libuv", "libwebp", "libxcrypt", "openjpeg", "openssl", "postgresql", "rubberband", "tcl", "tk", "zlib"]

[rules]

[rules.formatter]

[rules.formatter.fileExtensions]

[rules.formatter.fileExtensions.".json"]
id = "module:nodejs-20/formatter:prettier"
